---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.pages | concat: site.service | concat: site.area | concat: site.guide -%}
{%- for p in pages -%}
{%- unless p.sitemap == false or p.robots contains 'noindex' or p.url contains '404' or p.path contains '.xml' or p.path contains '.txt' -%}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <lastmod>{{ p.updated | default: site.time | date_to_xmlschema }}</lastmod>
    <changefreq>{% if p.url == '/' %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if p.url == '/' %}1.0{% elsif p.url contains '/service/' or p.url contains '/area/' %}0.8{% else %}0.6{% endif %}</priority>
  </url>
{%- endunless -%}
{%- endfor %}
</urlset>
