---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.data.sitemap %}
  <url>
    <loc>{{ site.url }}{{ item.path }}</loc>
    <changefreq>weekly</changefreq>
    <priority>{{ item.priority }}</priority>
    {% if item.updated %}<lastmod>{{ item.updated | date: '%Y-%m-%d' }}</lastmod>{% endif %}
  </url>
{% endfor %}
{% assign guide_list = site.guides | sort: 'date' | reverse %}
{% for guide in guide_list %}
  <url>
    <loc>{{ site.url }}{{ guide.url }}</loc>
    {% assign updated = guide.updated | default: guide.modified %}
    {% if updated %}<lastmod>{{ updated | date: '%Y-%m-%d' }}</lastmod>{% endif %}
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
{% endfor %}
</urlset>
